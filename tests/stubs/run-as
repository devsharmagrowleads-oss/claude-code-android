#!/bin/sh
# Test stand-in for run-as. Answers the questions setup.sh asks about Termux.
case "${F_TERMUX-absent}" in absent|foreign|broken) exit 1 ;; esac
case "$*" in
  *"/installed ]"*) [ "${F_INSTALLED-0}" = 1 ] ;;
  *"[ -e files/home/.claude-code-android ]"*) [ "$F_TERMUX" = ours ] ;;
  *"[ -x files/usr/bin/bash ]"*) [ "$F_TERMUX" != empty ] ;;
  *) exit 0 ;;
esac

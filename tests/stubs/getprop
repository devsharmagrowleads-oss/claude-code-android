#!/bin/sh
# Test stand-in for Android's getprop. Values come from F_* variables.
case "$1" in
  ro.build.version.sdk) echo "${F_SDK-33}" ;;
  ro.build.version.release) echo 13 ;;
  ro.product.cpu.abilist64) echo "${F_ABI64-arm64-v8a}" ;;
  ro.product.cpu.abi) echo "${F_ABI-arm64-v8a}" ;;
  ro.product.manufacturer) echo Fake ;;
  ro.product.model) echo Phone ;;
esac

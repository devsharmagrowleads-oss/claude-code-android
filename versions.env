# Pinned downloads and limits. Plain KEY=VALUE lines only: this file is read
# by install.ps1, install.sh and the scripts that run on the phone.
# To update a pin, change the version and its SHA-256 together.

# Termux app (the debuggable GitHub build, 64-bit ARM).
TERMUX_VERSION=v0.118.3
TERMUX_APK_URL=https://github.com/termux/termux-app/releases/download/v0.118.3/termux-app_v0.118.3%2Bgithub-debug_arm64-v8a.apk
TERMUX_APK_SHA256=72fdb596045116bf5ba1b5bdf5b26fddb9acc0bd074ad9f2da9eb0ae85e83a4e

# adb (Android platform-tools), only downloaded when the laptop has none.
# https://dl.google.com/android/repository/platform-tools_r<version>-<win|darwin|linux>.zip
ADB_VERSION=37.0.1
ADB_SHA256_WIN=45f4d63113e895ebde0c90f194099a4676b6ac653bd28d54314a9e022bbc1a99
ADB_SHA256_DARWIN=ee39ad5967e95c2a07f04dbcbde96b1a0c916ba376096db5d2f498b7727a5d1d
ADB_SHA256_LINUX=d230f13842f60f782a8645f9c813f8f845bf36089ea7289f28c48f17979313f1

# Linux guest inside Termux, pinned by digest so it is always the same image.
GUEST_NAME=claude-code
GUEST_IMAGE=debian:13-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

# Phone requirements.
MIN_SDK=24
MIN_FREE_MB=3000
